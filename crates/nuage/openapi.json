{
  "openapi": "3.1.0",
  "info": {
    "title": "Nuage DB",
    "version": "0.4.3",
    "summary": "SQL over HTTP: any language that can send JSON can use Nuage DB.",
    "description": "Send SQL with `?` (or `$1`) parameters to `POST /v1/sql` with the token of an application; rows come back as JSON objects. The token picks the application's database. Several statements (separated by `;`, or in `statements`) run in one transaction, all or nothing. Parameters are never parsed as SQL. Examples in many languages: https://github.com/maxlestage/Nuage/tree/master/clients Applications and their tokens are made with the management API, `/api/apps`, and the server's NUAGE_ADMIN_TOKEN. An application's files (map tiles, photos, archives) are at `/v1/files`: the server lists them and signs links to its S3-compatible bucket, and the bytes go straight between the client and the bucket.",
    "license": {
      "name": "MIT OR Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "token": []
    }
  ],
  "paths": {
    "/v1/ping": {
      "get": {
        "operationId": "ping",
        "summary": "Does my connection work?",
        "description": "The application the token opens, its access, branch and tables. Without a token, or with one that opens nothing, a 401 says what is wrong.",
        "responses": {
          "200": {
            "description": "Connected.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "server": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "application": {
                      "type": "string"
                    },
                    "access": {
                      "enum": [
                        "read-write",
                        "read-only"
                      ]
                    },
                    "branch": {
                      "type": "string"
                    },
                    "tables": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "message": "Connected to Nuage DB 0.4.2: application `blog`, read and write, branch `main`, 3 table(s).",
                  "application": "blog",
                  "access": "read-write",
                  "branch": "main",
                  "tables": 3
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sql": {
      "post": {
        "operationId": "sql",
        "summary": "Run SQL",
        "description": "One statement answers its result; several answer `{\"results\": [...]}`, one result per statement. A read-only token may only read.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Script"
                  },
                  {
                    "$ref": "#/components/schemas/Batch"
                  }
                ]
              },
              "examples": {
                "select": {
                  "value": {
                    "sql": "SELECT id, title FROM posts WHERE category = ? ORDER BY id DESC LIMIT 20",
                    "params": [
                      3
                    ]
                  }
                },
                "insert": {
                  "value": {
                    "sql": "INSERT INTO messages (name, text) VALUES (?, ?)",
                    "params": [
                      "Ada",
                      "Hello"
                    ]
                  }
                },
                "batch": {
                  "value": {
                    "statements": [
                      {
                        "sql": "UPDATE accounts SET balance = balance - ? WHERE id = ?",
                        "params": [
                          10,
                          1
                        ]
                      },
                      {
                        "sql": "UPDATE accounts SET balance = balance + ? WHERE id = ?",
                        "params": [
                          10,
                          2
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result of the statement, or of each statement.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Result"
                    },
                    {
                      "$ref": "#/components/schemas/Results"
                    }
                  ]
                },
                "examples": {
                  "rows": {
                    "value": {
                      "columns": [
                        "id",
                        "title"
                      ],
                      "rows": [
                        {
                          "id": 42,
                          "title": "Hello"
                        }
                      ]
                    }
                  },
                  "write": {
                    "value": {
                      "rows_affected": 1,
                      "last_insert_id": 7
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/files": {
      "get": {
        "operationId": "listFiles",
        "summary": "The application's files",
        "description": "The files of the application the token opens, sorted by name. A read-only token lists too.",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only the names that start with it (`regions/`)."
          }
        ],
        "responses": {
          "200": {
            "description": "The files.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "files",
                    "count",
                    "bytes"
                  ],
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/File"
                      }
                    },
                    "count": {
                      "type": "integer"
                    },
                    "bytes": {
                      "type": "integer",
                      "description": "Their total size."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or one that opens no application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "This server keeps no files: NUAGE_FILES_S3_BUCKET is not set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The bucket did not answer as it should (kind `storage`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/files/{name}": {
      "get": {
        "operationId": "downloadFile",
        "summary": "Download a file",
        "description": "A `307` redirect to a signed download link: the bytes come from the bucket, which answers `Range` requests (a download resumes where it stopped) and `404` for a missing file. A read-only token downloads too.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
            },
            "description": "The file's name: letters, digits, `.`, `_` and `-`, in parts separated by `/` (`regions/fr.tar`); no `.` or `..` part. In the path it stays as it is: `/v1/files/regions/fr.tar`."
          },
          {
            "name": "link",
            "in": "query",
            "required": false,
            "allowEmptyValue": true,
            "schema": {
              "type": "string"
            },
            "description": "Present (`?link`): the link as JSON instead of a redirect, for clients that keep the `Authorization` header on redirects."
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The bucket answers with `Content-Disposition: attachment`, under this file name (the last part of the name when empty)."
          }
        ],
        "responses": {
          "307": {
            "description": "To the signed link (`Location`)."
          },
          "200": {
            "description": "With `?link`: the link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Link"
                }
              }
            }
          },
          "400": {
            "description": "Not a file name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one that opens no application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "This server keeps no files: NUAGE_FILES_S3_BUCKET is not set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "uploadFileLink",
        "summary": "A link to upload a file",
        "description": "A signed upload link: `PUT` the bytes to `url`, with their `Content-Length` (5 GB at most). An existing file of that name is replaced. A read-write token only.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
            },
            "description": "The file's name: letters, digits, `.`, `_` and `-`, in parts separated by `/` (`regions/fr.tar`); no `.` or `..` part. In the path it stays as it is: `/v1/files/regions/fr.tar`."
          }
        ],
        "responses": {
          "200": {
            "description": "The upload link.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Link"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "method": {
                          "const": "PUT"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Not a file name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one that opens no application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A read-only token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "This server keeps no files: NUAGE_FILES_S3_BUCKET is not set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete a file",
        "description": "A missing file is no error. A read-write token only.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
            },
            "description": "The file's name: letters, digits, `.`, `_` and `-`, in parts separated by `/` (`regions/fr.tar`); no `.` or `..` part. In the path it stays as it is: `/v1/files/regions/fr.tar`."
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "deleted": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not a file name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one that opens no application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A read-only token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "This server keeps no files: NUAGE_FILES_S3_BUCKET is not set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The bucket did not answer as it should (kind `storage`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Is the server up?",
        "security": [],
        "responses": {
          "200": {
            "description": "Up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "status",
        "summary": "Live status: requests, latency, storage, memory, backups",
        "description": "With the token of an application: its own figures. Without credentials, a public subset when the server allows it (`NUAGE_PUBLIC_STATUS`).",
        "responses": {
          "200": {
            "description": "The status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/apps": {
      "get": {
        "operationId": "listApps",
        "summary": "Every application of the server",
        "description": "The first application (the server's own, `NUAGE_NAME`) first, then by name.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The applications.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "applications"
                  ],
                  "properties": {
                    "applications": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Application"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No management token, or a wrong one (an application's token never opens this API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The management API is off: set NUAGE_ADMIN_TOKEN on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createApp",
        "summary": "Create an application, with its own encrypted database and a first token",
        "description": "The token is in this answer only: the server keeps its SHA-256 digest. `env` holds the two lines to paste in the application's configuration. `nuage apps create <name>` sends this request.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,63}$",
                    "description": "1 to 63 lowercase letters, digits, `-` and `_`: the name of the application and of its database."
                  },
                  "description": {
                    "type": "string",
                    "description": "A note shown in the console."
                  }
                }
              },
              "example": {
                "name": "shop",
                "description": "The shop"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "application",
                    "token",
                    "env",
                    "message"
                  ],
                  "properties": {
                    "application": {
                      "$ref": "#/components/schemas/Application"
                    },
                    "token": {
                      "type": "string",
                      "description": "The first token (`nuage_…`), shown once."
                    },
                    "env": {
                      "$ref": "#/components/schemas/Env"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not a JSON object, a missing or invalid name, a field of the wrong type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "There is already an application with this name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No management token, or a wrong one (an application's token never opens this API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The management API is off: set NUAGE_ADMIN_TOKEN on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/apps/{name}": {
      "get": {
        "operationId": "getApp",
        "summary": "One application",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,63}$"
            },
            "description": "The application's name."
          }
        ],
        "responses": {
          "200": {
            "description": "The application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "404": {
            "description": "No such application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No management token, or a wrong one (an application's token never opens this API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The management API is off: set NUAGE_ADMIN_TOKEN on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/apps/{name}/tokens": {
      "post": {
        "operationId": "createAppToken",
        "summary": "Another token for an application",
        "description": "A read-only token reads and never writes: for the JavaScript of a website. Shown once.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,63}$"
            },
            "description": "The application's name."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "read_only": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              "example": {
                "read_only": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "application",
                    "token",
                    "read_only",
                    "env"
                  ],
                  "properties": {
                    "application": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "read_only": {
                      "type": "boolean"
                    },
                    "env": {
                      "$ref": "#/components/schemas/Env"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`read_only` is not a boolean.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No management token, or a wrong one (an application's token never opens this API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The management API is off: set NUAGE_ADMIN_TOKEN on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/apps/{name}/tokens/{id}": {
      "delete": {
        "operationId": "revokeAppToken",
        "summary": "Revoke a token",
        "description": "The token stops opening the database at once.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,63}$"
            },
            "description": "The application's name."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The token's id: its 8 characters after `nuage_`, as `tokens` lists them."
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such application, or no such token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No management token, or a wrong one (an application's token never opens this API).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The management API is off: set NUAGE_ADMIN_TOKEN on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer",
        "description": "A token of an application (the console's Tokens tab, or NUAGE_TOKEN)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The server's NUAGE_ADMIN_TOKEN (32 characters at least): it opens the management API, `/api/apps`, and nothing else."
      }
    },
    "schemas": {
      "Value": {
        "description": "A value: text, number, boolean, null, or JSON.",
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      },
      "Script": {
        "type": "object",
        "required": [
          "sql"
        ],
        "properties": {
          "sql": {
            "type": "string",
            "description": "One statement, or several separated by `;`."
          },
          "params": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Value"
            },
            "description": "Values of the `?` (in order) or `$n` parameters."
          },
          "arrays": {
            "type": "boolean",
            "default": false,
            "description": "Rows as arrays, in the order of `columns`, instead of objects."
          }
        }
      },
      "Batch": {
        "type": "object",
        "required": [
          "statements"
        ],
        "properties": {
          "statements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sql"
              ],
              "properties": {
                "sql": {
                  "type": "string"
                },
                "params": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Value"
                  }
                }
              }
            }
          },
          "arrays": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Statements that return rows."
          },
          "rows": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/Value"
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Value"
                  }
                }
              ]
            }
          },
          "rows_affected": {
            "type": "integer",
            "description": "Statements that change rows."
          },
          "last_insert_id": {
            "$ref": "#/components/schemas/Value"
          }
        }
      },
      "Results": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Result"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "kind",
              "message"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "description": "`validation` (bad SQL or values), `unique_violation`, `constraint`, `no_such_table`, `table_exists`, `conversion`, `unsupported`, `unauthorized`, `forbidden` (a read-only token writing), `not_found`, `conflict` (another commit came first: retry), `transaction_finished`, `database`; on `/api/apps`, also `method_not_allowed`; on `/v1/files`, also `not_configured` (no bucket) and `storage` (the bucket failed)."
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "read_only"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Its 8 characters after `nuage_`: enough to tell tokens apart, not to guess one."
          },
          "created_at": {
            "type": "integer",
            "description": "Unix milliseconds."
          },
          "read_only": {
            "type": "boolean"
          }
        }
      },
      "Application": {
        "type": "object",
        "required": [
          "name",
          "description",
          "first",
          "created_at",
          "tokens",
          "env_token",
          "origins"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "first": {
            "type": "boolean",
            "description": "The server's own application (`NUAGE_NAME`)."
          },
          "created_at": {
            "type": "integer",
            "description": "Unix milliseconds."
          },
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Token"
            },
            "description": "Its tokens, by id: never a token itself."
          },
          "env_token": {
            "type": "boolean",
            "description": "`NUAGE_TOKEN` opens it too (the first application)."
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Websites whose pages may call it from the browser (CORS)."
          }
        }
      },
      "Env": {
        "type": "object",
        "required": [
          "NUAGE_URL",
          "NUAGE_TOKEN"
        ],
        "description": "The two lines to paste in the application's configuration.",
        "properties": {
          "NUAGE_URL": {
            "type": "string",
            "description": "This server's address."
          },
          "NUAGE_TOKEN": {
            "type": "string"
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "name",
          "size",
          "updated",
          "etag"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Its name in the application's folder."
          },
          "size": {
            "type": "integer",
            "description": "Bytes."
          },
          "updated": {
            "type": "string",
            "description": "When it was last written, as the bucket says (`2026-11-15T07:16:00.000Z`)."
          },
          "etag": {
            "type": "string",
            "description": "Changes when the file changes (an MD5 of its bytes for a single upload)."
          }
        }
      },
      "Link": {
        "type": "object",
        "required": [
          "name",
          "url",
          "expires_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The signed link, to the bucket itself. Send it without an `Authorization` header."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "The link works until then (NUAGE_FILES_LINK_MINUTES, an hour by default)."
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "The statement failed; nothing was changed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
