# Environment of the `nuage` binary (the Nuage DB server). Copy to `.env` (never commit secrets).
PORT=8080
# Address to listen on: 127.0.0.1 behind a proxy on the same machine (Caddy, nginx).
NUAGE_BIND=0.0.0.0
# The PostgreSQL protocol: every language's PostgreSQL driver connects on this port, with any
# user name and a token as its password; the database name picks a branch (nuage: the main one).
NUAGE_PG_PORT=5432
# Its address, when NUAGE_BIND keeps the website behind a proxy.
# NUAGE_PG_BIND=0.0.0.0
# TLS for it (sslmode=require): a certificate and its key, PEM files.
# NUAGE_TLS_CERT=/etc/nuage/tls/cert.pem
# NUAGE_TLS_KEY=/etc/nuage/tls/key.pem
NUAGE_DATA_DIR=nuage-data
NUAGE_NAME=nuage
# The key everything is encrypted with (pages, log, backups): `nuage genkey` or
# `openssl rand -hex 32`, or a passphrase of 12 characters or more. Required. Keep a copy:
# without it the data and its backups cannot be read.
NUAGE_ENCRYPTION_KEY=
# Token of the first application: clients use NuageDb::connect(url, token). The console at
# /admin makes more applications, each with its own database and tokens.
NUAGE_TOKEN=change-me
# Password of the console at /admin.
NUAGE_ADMIN_PASSWORD=change-me-too
# true: /api/status shows a public subset (status, uptime, services) without credentials.
NUAGE_PUBLIC_STATUS=false
# Page cache of each application, in MiB, or auto: an eighth of the memory (8 to 512 MiB).
NUAGE_CACHE_MB=auto
# Backups, restored automatically into an empty data directory at startup: a folder on a
# disk that persists (another volume, a network share)...
# NUAGE_BACKUP_DIR=/mnt/backup/nuage
# ...or S3-compatible storage (required on hosts whose disk is ephemeral, such as Heroku).
# NUAGE_BACKUP_S3_BUCKET=my-bucket
# NUAGE_BACKUP_S3_REGION=eu-west-3
# NUAGE_BACKUP_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# NUAGE_BACKUP_S3_PREFIX=nuage/
# NUAGE_BACKUP_S3_ACCESS_KEY_ID=...
# NUAGE_BACKUP_S3_SECRET_ACCESS_KEY=...
# NUAGE_BACKUP_SNAPSHOT_MINUTES=60
# Public address of the website (canonical links, share card); else each request's Host.
# SITE_URL=https://my-nuage.herokuapp.com
# Hosts that put idle servers to sleep (Heroku Eco: after 30 minutes): the server requests its
# own address to stay awake. Eco hours are shared by every Eco app of the account.
# NUAGE_KEEP_AWAKE_URL=https://my-nuage.herokuapp.com/api/health
# NUAGE_KEEP_AWAKE_MINUTES=20
# NUAGE_KEEP_AWAKE_HOURS=6-22
